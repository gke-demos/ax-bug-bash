+// ensureActorEgressPolicy attaches the least-privilege cluster-internal EgressPolicy
+// ("default") to actorName before ResumeActor is invoked when AX_AUTO_ACTOR_EGRESS=true.
+func (c *Client) ensureActorEgressPolicy(ctx context.Context, atespace, actorName string) error {
+	val := strings.ToLower(strings.TrimSpace(os.Getenv("AX_AUTO_ACTOR_EGRESS")))
+	if val != "true" && val != "1" {
+		return nil
+	}
+	mkRule := func(hosts []string, ports []int32) *ateapipb.EgressRule {
+		return &ateapipb.EgressRule{
+			Http: &ateapipb.HttpRule{
+				Hostnames: hosts,
+				Ports:     &ateapipb.Ports{Numbers: ports},
+			},
+		}
+	}
+	req := &ateapipb.CreateActorEgressPolicyRequest{
+		Actor: &ateapipb.ObjectRef{
+			Atespace: atespace,
+			Name:     actorName,
+		},
+		EgressPolicy: &ateapipb.EgressPolicy{
+			Metadata: &ateapipb.ResourceMetadata{
+				Atespace: atespace,
+				Name:     "default",
+			},
+			Rules: []*ateapipb.EgressRule{
+				mkRule([]string{"ax-server.ax-system.svc.cluster.local", "ax-server.ax-system.svc"}, []int32{80, 8080, 9090}),
+				mkRule([]string{"model-gateway.ax-system.svc.cluster.local", "model-gateway.ax-system.svc"}, []int32{80, 8080}),
+				mkRule([]string{
+					"storefront.ax-bug-bash.svc.cluster.local",
+					"storefront.ax-bug-bash.svc",
+					"storefront-web.ax-bug-bash.svc.cluster.local",
+					"storefront-web.ax-bug-bash.svc",
+					"retail-storefront.ax-bug-bash.svc.cluster.local",
+				}, []int32{3001}),
+				mkRule([]string{"storefront-git.ax-bug-bash.svc.cluster.local", "storefront-git.ax-bug-bash.svc"}, []int32{8090}),
+				mkRule([]string{"ax-observer.ax-bug-bash.svc.cluster.local", "ax-observer.ax-bug-bash.svc"}, []int32{3000}),
+				mkRule([]string{"loki.monitoring.svc.cluster.local", "loki.monitoring.svc"}, []int32{3100}),
+			},
+		},
+	}
+	err := retryOnCodes(ctx, func() error {
+		_, err := c.control.CreateActorEgressPolicy(ctx, req)
+		return err
+	}, codes.Unavailable)
+	if err != nil && status.Code(err) != codes.AlreadyExists {
+		return fmt.Errorf("creating actor egress policy for %s/%s: %w", atespace, actorName, err)
+	}
+	return nil
 }
 
