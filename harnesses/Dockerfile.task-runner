FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/root \
    WORKSPACE_DIR=/workspace \
    GOCACHE=/var/cache/ax-build/gocache \
    GOMODCACHE=/var/cache/ax-build/gomodcache \
    CARGO_HOME=/var/cache/ax-build/cargo \
    CARGO_TARGET_DIR=/var/cache/ax-build/cargo-target \
    RUSTUP_HOME=/usr/local/rustup \
    VIRTUAL_ENV=/opt/ax-venv \
    NODE_PATH=/usr/local/lib/node_modules \
    PATH="/opt/ax-venv/bin:/usr/local/go/bin:/var/cache/ax-build/cargo/bin:/usr/local/bin:${PATH}" \
    GATEWAY_BASE_URL="http://model-gateway.ax-system.svc.cluster.local:8080" \
    GEMINI_API_KEY="ax-sandbox-token" \
    OPENAI_API_KEY="ax-sandbox-token" \
    AGENT_MODEL="gemini-3.8-flash" \
    TERM=xterm-256color

# Install system dependencies, Node.js 22, Go toolchain, and Rust (cargo/rustc)
RUN apt-get update && apt-get install -y --no-install-recommends \
      bash \
      build-essential \
      ca-certificates \
      curl \
      git \
      gnupg \
      jq \
      openssh-client \
      pkg-config \
      procps \
      ripgrep \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && curl -fsSL https://go.dev/dl/go1.23.6.linux-amd64.tar.gz | tar -C /usr/local -xz \
    && curl -fsSL https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal \
    && npm install -g opencode-ai @mariozechner/pi-coding-agent \
    && npm cache clean --force \
    && python3 -m venv /opt/ax-venv \
    && /opt/ax-venv/bin/pip install --no-cache-dir google-antigravity pytest fastapi httpx pydantic \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /workspace /workspace/.ax-state /workspace/.ax \
                /var/cache/ax-build/gocache /var/cache/ax-build/gomodcache /var/cache/ax-build/cargo /var/cache/ax-build/cargo-target \
                /root/.config/opencode /root/.pi/agent \
    && rm -rf /ax && ln -s /workspace/.ax /ax \
    && chmod 1777 /tmp \
    && git config --system user.name "AX Bug Bash Agent" \
    && git config --system user.email "agent@ax-bug-bash.local" \
    && git config --system init.defaultBranch main \
    && git config --system safe.directory "*"

COPY harnesses/config/opencode.json /root/.config/opencode/opencode.json
COPY harnesses/config/pi-models.json /root/.pi/agent/models.json
COPY services/ /tmp/prewarm/services/
COPY bin/linux_amd64/ax-task-runner /usr/local/bin/ax-task-runner
COPY harnesses/bin/antigravity /usr/local/bin/antigravity
COPY harnesses/bin/opencode-harness /usr/local/bin/opencode-harness
COPY harnesses/bin/pi-harness /usr/local/bin/pi-harness

RUN printf "module github.com/gke-demos/ax-bug-bash\n\ngo 1.23\n" > /tmp/prewarm/go.mod \
    && (cd /tmp/prewarm && go test -c -o /tmp/prewarm/checkout.test ./services/checkout-service && go test -c -o /tmp/prewarm/shipping.test ./services/shipping-service) \
    && (cd /tmp/prewarm/services/inventory-service && cargo test --no-run) \
    && /opt/ax-venv/bin/python3 -m compileall /tmp/prewarm/services/pricing-service \
    && node --check /tmp/prewarm/services/storefront-web/test/storefront.test.mjs \
    && rm -rf /tmp/prewarm \
    && chmod +x /usr/local/bin/ax-task-runner \
             /usr/local/bin/antigravity \
             /usr/local/bin/opencode-harness \
             /usr/local/bin/pi-harness

WORKDIR /workspace
EXPOSE 80

ENTRYPOINT ["/usr/local/bin/ax-task-runner"]
